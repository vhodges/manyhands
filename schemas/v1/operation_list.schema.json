{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manyhands JSON v1 unfinished operations",
  "description": "Ordered by operation ID; operations with no ID follow, in the order they were stored.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "complete"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "operation.schema.json"
      }
    },
    "complete": {
      "type": "boolean"
    }
  }
}
