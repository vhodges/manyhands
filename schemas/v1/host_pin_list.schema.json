{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manyhands JSON v1 SSH host pins",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "complete", "reapproval_required"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "host_pin.schema.json"
      }
    },
    "complete": {
      "type": "boolean"
    },
    "reapproval_required": {
      "type": "boolean"
    }
  }
}
