{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manyhands JSON v1 document or ticket",
  "description": "A nonconforming entry has a null id and null metadata. In a list, body, source and observation are null. A ticket's slug, parent and deps are its own fields and are not repeated in unknown_metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "path",
    "title",
    "type",
    "status",
    "project",
    "team",
    "closure",
    "slug",
    "parent",
    "deps",
    "readiness",
    "unknown_metadata",
    "body",
    "source",
    "observation",
    "context",
    "changed_at",
    "change_source",
    "problems",
    "index"
  ],
  "properties": {
    "id": {
      "type": ["string", "null"]
    },
    "kind": {
      "type": "string",
      "enum": ["document", "ticket"]
    },
    "path": {
      "type": "string"
    },
    "title": {
      "type": ["string", "null"]
    },
    "type": {
      "type": ["string", "null"]
    },
    "status": {
      "type": ["string", "null"]
    },
    "project": {
      "type": ["string", "null"]
    },
    "team": {
      "type": ["string", "null"]
    },
    "closure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["state", "closed_at", "closed_by"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["open", "closed"]
        },
        "closed_at": {
          "type": ["string", "null"]
        },
        "closed_by": {
          "type": ["string", "null"]
        }
      }
    },
    "slug": {
      "type": ["string", "null"]
    },
    "parent": {
      "description": "The ticket's parent, in the shape of a dependency.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "state"],
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": ["open", "closed", "unresolved"]
        }
      }
    },
    "deps": {
      "type": "array",
      "items": {
        "$ref": "dependency.schema.json"
      }
    },
    "readiness": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["state", "reasons"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["ready", "blocked", "closed"]
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "readiness_reason.schema.json"
          }
        }
      }
    },
    "unknown_metadata": {
      "description": "Front matter keys Manyhands does not define. Any JSON value may appear under a key.",
      "type": "object"
    },
    "body": {
      "type": ["string", "null"]
    },
    "source": {
      "type": ["string", "null"]
    },
    "observation": {
      "type": ["string", "null"]
    },
    "context": {
      "$ref": "item_context.schema.json"
    },
    "changed_at": {
      "type": ["string", "null"]
    },
    "change_source": {
      "type": ["string", "null"],
      "enum": ["git_commit", "uncommitted", null]
    },
    "problems": {
      "type": "array",
      "items": {
        "$ref": "problem.schema.json"
      }
    },
    "index": {
      "$ref": "repository_index.schema.json"
    }
  }
}
