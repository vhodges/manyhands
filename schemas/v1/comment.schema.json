{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manyhands JSON v1 comment",
  "description": "A nonconforming entry has a null id, parent_id, author, created_at and body, and no replies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "item_id",
    "parent_id",
    "author",
    "created_at",
    "body",
    "path",
    "unknown_metadata",
    "problems",
    "replies"
  ],
  "properties": {
    "id": {
      "type": ["string", "null"]
    },
    "item_id": {
      "type": "string"
    },
    "parent_id": {
      "type": ["string", "null"]
    },
    "author": {
      "type": ["string", "null"]
    },
    "created_at": {
      "type": ["string", "null"]
    },
    "body": {
      "type": ["string", "null"]
    },
    "path": {
      "type": "string"
    },
    "unknown_metadata": {
      "description": "Front matter keys Manyhands does not define. Any JSON value may appear under a key.",
      "type": "object"
    },
    "problems": {
      "type": "array",
      "items": {
        "$ref": "problem.schema.json"
      }
    },
    "replies": {
      "type": "array",
      "items": {
        "$ref": "comment.schema.json"
      }
    }
  }
}
