{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manyhands JSON v1 content problem",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "path", "target_id", "guidance"],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "invalid_path",
        "missing_front_matter",
        "malformed_front_matter",
        "malformed_configuration",
        "missing_field",
        "invalid_field",
        "kind_path_mismatch",
        "duplicate_id",
        "missing_comment_item",
        "missing_parent",
        "cross_item_parent",
        "comment_cycle",
        "source_unreadable",
        "context_problem",
        "branch_problem",
        "retry_required",
        "relationship_wrong_type",
        "relationship_invalid_id",
        "relationship_self_reference",
        "duplicate_dependency",
        "invalid_slug",
        "path_not_utf8",
        "metadata_not_representable",
        "relationship_not_a_ticket",
        "unknown_problem"
      ]
    },
    "path": {
      "type": ["string", "null"]
    },
    "target_id": {
      "description": "The item ID a problem with a ticket's deps or parent is about. Null for every other problem.",
      "type": ["string", "null"]
    },
    "guidance": {
      "type": "string"
    }
  }
}
