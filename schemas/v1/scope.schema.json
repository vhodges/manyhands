{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manyhands JSON v1 result scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "item_id", "branch", "worktree", "remote"],
  "properties": {
    "repository": {
      "type": ["string", "null"]
    },
    "item_id": {
      "type": ["string", "null"]
    },
    "branch": {
      "type": ["string", "null"]
    },
    "worktree": {
      "type": ["string", "null"]
    },
    "remote": {
      "type": ["string", "null"]
    }
  }
}
