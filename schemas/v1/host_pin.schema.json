{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manyhands JSON v1 SSH host pin",
  "type": "object",
  "additionalProperties": false,
  "required": ["host", "port", "algorithm", "sha256", "reapproval_required"],
  "properties": {
    "host": {
      "type": "string"
    },
    "port": {
      "type": "integer"
    },
    "algorithm": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    },
    "reapproval_required": {
      "type": "boolean"
    }
  }
}
