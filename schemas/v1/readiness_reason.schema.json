{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manyhands JSON v1 reason a ticket is blocked",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "ids"],
  "properties": {
    "code": {
      "type": "string",
      "enum": ["open_dependency", "unresolved_dependency", "dependency_cycle"]
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
