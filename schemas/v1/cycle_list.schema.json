{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manyhands JSON v1 ticket cycles",
  "description": "Dependency cycles and then parent cycles, each kind ordered by its cycles' lowest IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "complete", "index"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "cycle.schema.json"
      }
    },
    "complete": {
      "type": "boolean"
    },
    "index": {
      "$ref": "repository_index.schema.json"
    }
  }
}
