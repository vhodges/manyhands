  "title": "Key generation input",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "protection"],
  "properties": {
    "label": { "type": "string" },
    "protection": { "type": "string", "enum": ["passphrase", "none"] }
  }
}
