#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

# Times the Manyhands write commands on a scratch replica of the real
# repository, so the same measurement can be repeated before and after each
# phase of the fast-writes work (ticket vh-f3wts).
#
# Phases, all on one persistent scratch root:
#
#   measure-writes setup --root DIR --build-ref REF [--local-only] [--ssh-port N]
#   measure-writes trust-host --root DIR [--fingerprint SHA256:...]
#   measure-writes run --root DIR [--runs N] --out CSV
#
# setup builds the CLI from `git archive REF` of the main checkout, makes the
# scratch environment, the replica and (unless --local-only) a bare remote at
# ssh://$USER@127.0.0.1/<path>, then stops at the point where the owner must
# act: add the printed public key to ~/.ssh/authorized_keys and check the
# printed host fingerprint. trust-host pins that host and polls once to
# materialize every open context. run takes the timings.
#
# run writes the CSV `command,run,seconds,build_ref`: ticket save, document
# save, ticket create, comment add, "comment add (local checkpoint)" (the time
# until the CLI's first publication progress line, NA when there is none),
# item sync, document promote and ticket close (each as --prepare and
# --confirm), index refresh and poll once. The fixed ticket (the oldest open
# one with a context) and the fixed document (the first managed one) are
# chosen once per root. The promote and close run on items the script creates.
#
# --local-only skips what needs a remote (item sync, promote, close, poll
# once, the whole-command comment add): its remote is an unreachable address,
# and the open contexts are made with `git worktree add` in the replica,
# because without a remote only a poll could materialize them.
#
# The script never touches the real repository's data. Every CLI call runs
# with HOME, MANYHANDS_DATA_DIR, the XDG directories and GIT_CONFIG_GLOBAL
# under the scratch root, in an otherwise empty environment, and only the
# binary this script built is ever run.

main_checkout=/home/vhodges/work/src/manyhands
program=${0##*/}

die() {
    printf '%s: %s\n' "$program" "$*" >&2
    exit 1
}

note() {
    printf '%s: %s\n' "$program" "$*" >&2
}

usage() {
    cat >&2 <<EOF
usage:
  $program setup --root DIR --build-ref REF [--local-only] [--ssh-port N]
  $program trust-host --root DIR [--fingerprint SHA256:...]
  $program run --root DIR [--runs N] --out CSV
EOF
    exit 2
}

# is_under CHILD PARENT: true when CHILD is PARENT or inside it. Both must be
# canonical absolute paths.
is_under() {
    local child=${1%/} parent=${2%/}
    [[ $child == "$parent" || $child == "$parent"/* ]]
}

# ---------------------------------------------------------------- safety

real_home=$(getent passwd "$(id -u)" | cut -d: -f6 || true)
real_home=${real_home:-${HOME:-}}

# Directories that hold real Manyhands data, or the real repository. The
# scratch root must be neither inside nor above any of them.
protected_paths() {
    local path
    printf '%s\n' "$main_checkout"
    if [[ -n $real_home ]]; then
        printf '%s\n' "$real_home/.local/share/manyhands"
        printf '%s\n' "$real_home/.ssh"
    fi
    for path in "${MANYHANDS_DATA_DIR:-}" "${XDG_DATA_HOME:+$XDG_DATA_HOME/manyhands}"; do
        [[ -n $path ]] && realpath -m -- "$path"
    done
    return 0
}

root=
data_dir=
cli=

# check_root: refuses a root that is, contains or lies inside real data. Sets
# the derived scratch paths.
check_root() {
    [[ -n $root ]] || die '--root is required'
    root=$(realpath -m -- "$root")
    [[ $root != / ]] || die 'refusing --root /'
    local protected
    while IFS= read -r protected; do
        [[ -n $protected ]] || continue
        if is_under "$root" "$protected"; then
            die "refusing --root $root: it is inside $protected"
        fi
        if is_under "$protected" "$root"; then
            die "refusing --root $root: it contains $protected"
        fi
    done < <(protected_paths)
    [[ -n $real_home ]] && [[ $root == "$real_home" ]] && die "refusing --root $root: it is the home directory"

    data_dir=$root/data
    cli=$root/target/release/manyhands-cli
    is_under "$data_dir" "$root" || die "MANYHANDS_DATA_DIR $data_dir is not under $root"
}

# check_cli: the binary this script built, and nothing else, may run, and only
# against scratch locations. Called before every CLI invocation.
check_cli() {
    [[ -f $cli && -x $cli ]] || die "no built CLI at $cli: run setup first"
    local resolved path
    resolved=$(realpath -- "$cli")
    is_under "$resolved" "$root" || die "the CLI binary $resolved is not under $root"
    is_under "$data_dir" "$root" || die "MANYHANDS_DATA_DIR $data_dir is not under $root"
    for path in "$data_dir" "$root/home" "$root/xdg-data" "$root/xdg-config" \
        "$root/xdg-state" "$root/xdg-cache" "$root/tmp" "$root/gitconfig"; do
        resolved=$(realpath -m -- "$path")
        is_under "$resolved" "$root" || die "$path resolves to $resolved, which is not under $root"
    done
}

# ------------------------------------------------------- scratch environment

# Runs a program in an empty environment with only the scratch locations set,
# so nothing of the person's session (HOME, SSH_AUTH_SOCK, GIT_DIR, ...)
# reaches it.
scratch_env() {
    env -i \
        PATH="$PATH" \
        LC_ALL=C \
        HOME="$root/home" \
        MANYHANDS_DATA_DIR="$data_dir" \
        XDG_DATA_HOME="$root/xdg-data" \
        XDG_CONFIG_HOME="$root/xdg-config" \
        XDG_STATE_HOME="$root/xdg-state" \
        XDG_CACHE_HOME="$root/xdg-cache" \
        GIT_CONFIG_GLOBAL="$root/gitconfig" \
        GIT_CONFIG_NOSYSTEM=1 \
        TMPDIR="$root/tmp" \
        "$@"
}

cli() {
    check_cli
    scratch_env "$cli" "$@"
}

scratch_git() {
    scratch_env git "$@"
}

make_scratch_dirs() {
    mkdir -p "$root" "$data_dir" "$root/home" "$root/xdg-data" "$root/xdg-config" \
        "$root/xdg-state" "$root/xdg-cache" "$root/tmp" "$root/inputs"
    : >"$root/gitconfig"
}

# ----------------------------------------------------------------- settings

settings_file() {
    printf '%s/measure-writes.settings' "$root"
}

# setting_get NAME: prints the value, or nothing when it is unset.
setting_get() {
    local file
    file=$(settings_file)
    [[ -f $file ]] || return 0
    sed -n "s/^$1=//p" "$file" | tail -n 1
}

setting_set() {
    local file
    file=$(settings_file)
    touch "$file"
    grep -v "^$1=" "$file" >"$file.new" || true
    printf '%s=%s\n' "$1" "$2" >>"$file.new"
    mv "$file.new" "$file"
}

require_setup() {
    [[ -f $(settings_file) ]] || die "no scratch root at $root: run setup first"
    [[ $(setting_get setup_complete) == yes ]] || die "setup did not finish at $root: run setup again"
}

# --------------------------------------------------------------------- JSON

json_get() {
    python3 -I -c '
import json, sys
value = json.load(sys.stdin)
for part in sys.argv[1].split("."):
    if value is None:
        break
    value = value[int(part)] if isinstance(value, list) else value.get(part)
if value is None:
    print("")
elif isinstance(value, bool):
    print("true" if value else "false")
elif isinstance(value, (dict, list)):
    print(json.dumps(value))
else:
    print(value)
' "$1"
}

# write_json FILE KEY VALUE...: a flat JSON object of string values.
write_json() {
    local file=$1
    shift
    python3 -I -c '
import json, sys
args = sys.argv[2:]
with open(sys.argv[1], "w") as handle:
    json.dump(dict(zip(args[0::2], args[1::2])), handle)
' "$file" "$@"
}

# --------------------------------------------------------------- CLI helpers

new_id() {
    cli id new
}

# api_ok DESCRIPTION ARGS...: runs a write or read with --json
# --non-interactive and stores the answer in $answer. Exit status 0 only when
# the outcome is success or noop.
api() {
    local rc=0
    answer=$(cli --json --non-interactive "$@") || rc=$?
    api_status=$rc
    return 0
}

api_must() {
    local description=$1
    shift
    api "$@"
    local outcome code
    outcome=$(json_get outcome <<<"$answer" 2>/dev/null || true)
    code=$(json_get code <<<"$answer" 2>/dev/null || true)
    case $outcome in
        success | noop) ;;
        *) die "$description failed: exit $api_status, outcome '$outcome', code '$code': $answer" ;;
    esac
}

# confirmed DESCRIPTION INPUT_ARGS... : prepare, then confirm, a confirmable verb.
confirmed() {
    local description=$1
    shift
    api_must "$description (prepare)" "$@" --prepare
    local confirmation
    confirmation=$(json_get data.confirmation_id <<<"$answer")
    [[ -n $confirmation ]] || die "$description (prepare) gave no confirmation_id: $answer"
    api_must "$description (confirm)" "$@" --confirm "$confirmation" --request-id "$(new_id)"
}

# ------------------------------------------------------------- setup phase

build_cli() {
    local ref=$1 sha
    sha=$(git -C "$main_checkout" rev-parse --verify "$ref^{commit}") || die "unknown build ref $ref"
    note "building $ref ($sha) from git archive of $main_checkout"
    rm -rf "$root/src"
    mkdir -p "$root/src"
    git -C "$main_checkout" archive "$sha" | tar -x -C "$root/src"
    local log=$root/build.log
    if (cd "$root/src" && CARGO_TARGET_DIR=$root/target devenv shell -- \
        cargo build --release --locked --bin manyhands-cli) >"$log" 2>&1; then
        note "built with devenv from the archive directory (log: $log)"
    else
        note "devenv could not build from the archive directory; building with the main checkout's devenv"
        (cd "$main_checkout" && CARGO_TARGET_DIR=$root/target devenv shell -- \
            cargo build --release --locked --bin manyhands-cli \
            --manifest-path "$root/src/Cargo.toml") >>"$log" 2>&1 \
            || die "build failed, see $log"
        note "built with devenv from $main_checkout using --manifest-path (log: $log)"
        setting_set build_note "built from the main checkout's devenv with --manifest-path"
    fi
    setting_set build_sha "$sha"
    check_cli
}

setup_replica() {
    local replica=$root/replica bare=$root/remote.git
    note "cloning $main_checkout into $replica"
    scratch_git clone --quiet --no-local --no-tags --branch main "$main_checkout" "$replica"
    # Every branch the real remote holds: the main checkout's remote-tracking
    # branches become local branches of the replica.
    scratch_git -C "$replica" fetch --quiet --no-tags "$main_checkout" \
        '+refs/remotes/origin/manyhands/*:refs/heads/manyhands/*'
    # The clone's origin points at the main checkout and its tracking refs at
    # that checkout's local branches, not at a remote. Drop both; the real
    # remote is added below, and the first poll records its refs.
    scratch_git -C "$replica" remote remove origin

    local url
    if [[ $local_only == true ]]; then
        url=ssh://git@127.0.0.1:1/unreachable/remote.git
    else
        note "creating the bare remote $bare"
        scratch_git clone --quiet --bare --no-local "$replica" "$bare"
        if [[ $ssh_port == 22 ]]; then
            url=ssh://$(id -un)@127.0.0.1$bare
        else
            url=ssh://$(id -un)@127.0.0.1:$ssh_port$bare
        fi
    fi
    scratch_git -C "$replica" remote add origin "$url"
    setting_set remote_url "$url"
    note "replica has $(scratch_git -C "$replica" for-each-ref --format='x' refs/heads/manyhands | wc -l) manyhands/* branches; remote is $url"
}

setup_registry() {
    local replica=$root/replica dir=$root/inputs
    local identity_name='Measure Writes' identity_email='measure-writes@example.invalid'

    write_json "$dir/key.json" label 'measure-writes throwaway' protection none
    api_must 'key generate' key generate --input "$dir/key.json" --request-id "$(new_id)"
    local key_id
    key_id=$(json_get data.id <<<"$answer")
    [[ -n $key_id ]] || die "key generate gave no id: $answer"
    api_must 'key select' key select --key-id "$key_id" --request-id "$(new_id)"
    setting_set key_id "$key_id"

    python3 -I -c '
import json, sys
json.dump({"primary_branch": "main", "identity": {"name": sys.argv[2], "email": sys.argv[3]}}, open(sys.argv[1], "w"))
' "$dir/enable.json" "$identity_name" "$identity_email"
    confirmed 'repo enable' repo enable --repo "$replica" --input "$dir/enable.json"

    write_json "$dir/identity.json" name "$identity_name" email "$identity_email"
    confirmed 'repo identity-set' repo identity-set --repo "$replica" --input "$dir/identity.json"

    api_must 'repo inspect' repo inspect --repo "$replica"
    local selected
    selected=$(json_get data.configuration.publication_remote <<<"$answer")
    [[ $selected == origin ]] || die "expected publication remote origin, repo inspect says '$selected'"
}

# materialize_local_contexts: what a poll does for every remote branch, done
# with git because the CLI has no verb for it without a remote (`context
# prepare` does not exist). The replica is scratch.
materialize_local_contexts() {
    local replica=$root/replica branch id count=0
    mkdir -p "$replica/.manyhands/worktrees"
    while IFS= read -r branch; do
        id=${branch##*/}
        scratch_git -C "$replica" worktree add --quiet "$replica/.manyhands/worktrees/$id" "$branch"
        count=$((count + 1))
    done < <(scratch_git -C "$replica" for-each-ref --format='%(refname:short)' refs/heads/manyhands)
    note "materialized $count local contexts with git worktree add in the replica"
    api_must 'index refresh' index refresh --repo "$replica" --request-id "$(new_id)"
}

# host_fingerprints: what ssh-keyscan sees at the host, as ssh-keygen prints it,
# one line per key type: "256 SHA256:... 127.0.0.1 (ED25519)".
host_fingerprints() {
    ssh-keyscan -p "$ssh_port" -T 5 127.0.0.1 2>/dev/null | ssh-keygen -lf - 2>/dev/null || true
}

print_owner_steps() {
    local public fingerprint
    public=$(cli key public --key-id "$(setting_get key_id)")
    fingerprint=$(ssh-keyscan -p "$ssh_port" -T 5 -t ed25519 127.0.0.1 2>/dev/null | ssh-keygen -lf - 2>/dev/null || true)
    [[ -n $fingerprint ]] || fingerprint='(ssh-keyscan found no ed25519 key at 127.0.0.1: is sshd running?)'
    cat <<EOF

Setup is done up to the owner's step. Nothing has been trusted yet.

1. Throwaway public key (no passphrase; the private half stays under
   $root/home/.ssh). Add this line to ~/.ssh/authorized_keys for localhost:

$public

2. The host key 127.0.0.1 presents (ssh-keyscan -t ed25519 127.0.0.1):

   $fingerprint

Then run:
   $program trust-host --root $root
EOF
}

phase_setup() {
    local build_ref=
    local_only=false
    ssh_port=22
    while (($#)); do
        case $1 in
            --root) root=${2:?--root needs a value}; shift 2 ;;
            --build-ref) build_ref=${2:?--build-ref needs a value}; shift 2 ;;
            --local-only) local_only=true; shift ;;
            --ssh-port) ssh_port=${2:?--ssh-port needs a value}; shift 2 ;;
            *) usage ;;
        esac
    done
    [[ -n $build_ref ]] || die '--build-ref is required'
    [[ $ssh_port =~ ^[0-9]+$ ]] || die '--ssh-port must be a number'
    check_root
    command -v python3 >/dev/null || die 'python3 is required'
    command -v devenv >/dev/null || die 'devenv is required'

    if [[ -e $root ]] && [[ -n $(ls -A "$root") ]]; then
        [[ -f $root/.measure-writes-root ]] || die "$root exists, is not empty and is not a measure-writes root"
        note "reusing $root: removing the previous scratch state (the build cache is kept)"
        rm -rf "${root:?}/replica" "${root:?}/remote.git" "$data_dir" "${root:?}/home" \
            "${root:?}/xdg-data" "${root:?}/xdg-config" "${root:?}/xdg-state" \
            "${root:?}/xdg-cache" "${root:?}/tmp" "${root:?}/inputs" \
            "${root:?}/gitconfig" "${root:?}/measure-writes.settings"
    fi
    make_scratch_dirs
    : >"$root/.measure-writes-root"

    setting_set build_ref "$build_ref"
    setting_set local_only "$local_only"
    setting_set ssh_port "$ssh_port"
    build_cli "$build_ref"
    note "CLI: $(cli --version)"
    setup_replica
    setup_registry
    if [[ $local_only == true ]]; then
        materialize_local_contexts
        setting_set setup_complete yes
        note "local-only setup finished"
    else
        setting_set setup_complete yes
        print_owner_steps
    fi
}

# ---------------------------------------------------------- trust-host phase

# elapsed START END: seconds between two `date +%s.%N` values.
elapsed() {
    awk -v start="$1" -v end="$2" 'BEGIN { printf "%.3f", end - start }'
}

phase_trust_host() {
    local expected=
    while (($#)); do
        case $1 in
            --root) root=${2:?--root needs a value}; shift 2 ;;
            --fingerprint) expected=${2:?--fingerprint needs a value}; shift 2 ;;
            *) usage ;;
        esac
    done
    check_root
    require_setup
    [[ $(setting_get local_only) == false ]] || die 'this root was set up with --local-only: there is no remote to trust'
    ssh_port=$(setting_get ssh_port)
    local replica=$root/replica

    # host observe connects and reads the host's key; it trusts nothing.
    api_must 'host observe' host observe --repo "$replica"
    local host port algorithm fingerprint
    host=$(json_get data.host <<<"$answer")
    port=$(json_get data.port <<<"$answer")
    algorithm=$(json_get data.presented_algorithm <<<"$answer")
    fingerprint=$(json_get data.presented_fingerprint <<<"$answer")
    [[ -n $host && -n $port && -n $algorithm && -n $fingerprint ]] \
        || die "host observe gave no host key: $answer"
    [[ $host == 127.0.0.1 ]] || die "refusing to approve $host: this script trusts only 127.0.0.1"
    note "host $host:$port presents $algorithm $fingerprint"

    # Cross-check what Manyhands saw against what ssh-keyscan sees.
    if ! host_fingerprints | awk '{print $2}' | grep -Fxq -- "$fingerprint"; then
        die "ssh-keyscan at 127.0.0.1:$port does not show $fingerprint: not approving"
    fi
    if [[ -n $expected && $expected != "$fingerprint" ]]; then
        die "the host presents $fingerprint, not the expected $expected: not approving"
    fi

    python3 -I -c '
import json, sys
json.dump({"authority": sys.argv[2], "algorithm": sys.argv[3], "fingerprint": sys.argv[4]}, open(sys.argv[1], "w"))
' "$root/inputs/approve.json" "$host:$port" "$algorithm" "$fingerprint"
    confirmed 'host approve' host approve --repo "$replica" --input "$root/inputs/approve.json"
    note "approved $host:$port"

    # The first poll materializes every open context.
    local start end
    start=$(date +%s.%N)
    api_must 'poll once' poll once --repo "$replica" --request-id "$(new_id)"
    end=$(date +%s.%N)
    note "poll once took $(elapsed "$start" "$end") s"
    python3 -I -c '
import json, sys
from collections import Counter
targets = json.load(sys.stdin)["data"].get("targets") or []
print("measure-writes: poll targets:", dict(Counter(t.get("disposition") for t in targets)), file=sys.stderr)
' <<<"$answer"
    setting_set trusted yes
    note "trust-host finished; next: $program run --root $root --out <csv>"
}

# ----------------------------------------------------------------- run phase

csv_partial=
build_ref_label=

# record NAME RUN SECONDS
record() {
    printf '%s,%s,%s,%s\n' "$1" "$2" "$3" "$build_ref_label" >>"$csv_partial"
    printf '%-38s run %s %9s s\n' "$1" "$2" "$3" >&2
}

# timed_api NAME RUN ARGS...: times one CLI call (with --json --non-interactive)
# and records it. The call must succeed. The answer is left in $answer.
timed_api() {
    local name=$1 run=$2 start end rc=0 outcome
    shift 2
    start=$(date +%s.%N)
    answer=$(cli --json --non-interactive "$@") || rc=$?
    end=$(date +%s.%N)
    outcome=$(json_get outcome <<<"$answer" 2>/dev/null || true)
    case $outcome in
        success | noop) ;;
        *) die "$name failed (exit $rc, outcome '$outcome', code '$(json_get code <<<"$answer" 2>/dev/null || true)'): $answer" ;;
    esac
    record "$name" "$run" "$(elapsed "$start" "$end")"
}

# timed_confirmed NAME RUN ARGS...: times the --prepare and the --confirm of a
# confirmable verb as two rows, "NAME --prepare" and "NAME --confirm".
timed_confirmed() {
    local name=$1 run=$2 confirmation
    shift 2
    timed_api "$name --prepare" "$run" "$@" --prepare
    confirmation=$(json_get data.confirmation_id <<<"$answer")
    [[ -n $confirmation ]] || die "$name --prepare gave no confirmation_id: $answer"
    timed_api "$name --confirm" "$run" "$@" --confirm "$confirmation" --request-id "$(new_id)"
}

# stamp_lines: copies stdin to stdout, each line prefixed by the time it was read.
stamp_lines() {
    local line
    while IFS= read -r line; do
        printf '%s %s\n' "$(date +%s.%N)" "$line"
    done
}

# save_patch SHOW_JSON STAMP OUT: a save patch for the shown item: its own body
# with a closing "measure-writes run STAMP" line, replacing the line a previous
# run left, so the content differs every time and does not grow.
save_patch() {
    python3 -I -c '
import json, re, sys
data = json.load(open(sys.argv[1]))["data"]
body = re.sub(r"\n*measure-writes run [^\n]*\s*$", "", data.get("body") or "")
body = body.rstrip("\n") + "\n\nmeasure-writes run " + sys.argv[2] + "\n"
json.dump({"observation": data["observation"], "body": body}, open(sys.argv[3], "w"))
' "$1" "$2" "$3"
}

# pick_fixed_items REPLICA: the oldest open ticket that has a context of its
# own, and the first managed document (the lowest ID without a problem). Chosen
# once per root and kept, so every run of a root measures the same items.
pick_fixed_items() {
    local replica=$1
    if [[ -z $(setting_get fixed_ticket) ]]; then
        api_must 'ticket list' ticket list --repo "$replica" --closure open
        setting_set fixed_ticket "$(python3 -I -c '
import json, sys
items = [i for i in json.load(sys.stdin)["data"]["items"]
         if i["context"]["kind"] == "active" and not i["problems"]]
print(min(items, key=lambda i: i["id"])["id"] if items else "")
' <<<"$answer")"
        [[ -n $(setting_get fixed_ticket) ]] || die 'no open ticket with a context of its own in the replica'
    fi
    if [[ -z $(setting_get fixed_document) ]]; then
        api_must 'document list' document list --repo "$replica"
        setting_set fixed_document "$(python3 -I -c '
import json, sys
items = [i for i in json.load(sys.stdin)["data"]["items"] if i["id"] and not i["problems"]]
print(min(items, key=lambda i: i["id"])["id"] if items else "")
' <<<"$answer")"
        [[ -n $(setting_get fixed_document) ]] || die 'no managed document in the replica'
    fi
}

# write_ticket_input: the input of a ticket create, for the ID in $item_id.
write_ticket_input() {
    python3 -I -c '
import json, sys
json.dump({"item_id": sys.argv[2], "title": sys.argv[3], "type": "task", "status": "open",
           "body": "Created by measure-writes."}, open(sys.argv[1], "w"))
' "$root/inputs/ticket-create.json" "$item_id" "$1"
}

# create_ticket: an untimed ticket create; leaves the ID in $item_id.
create_ticket() {
    item_id=$(new_id)
    write_ticket_input 'measure-writes ticket to close'
    api_must 'ticket create' ticket create --repo "$root/replica" \
        --input "$root/inputs/ticket-create.json" --request-id "$(new_id)"
}

# timed_create_ticket RUN: the timed "ticket create"; leaves the ID in $item_id.
timed_create_ticket() {
    item_id=$(new_id)
    write_ticket_input 'measure-writes ticket'
    timed_api 'ticket create' "$1" ticket create --repo "$root/replica" \
        --input "$root/inputs/ticket-create.json" --request-id "$(new_id)"
}

# create_document: an untimed document create; leaves the ID in $item_id.
create_document() {
    item_id=$(new_id)
    python3 -I -c '
import json, sys
json.dump({"item_id": sys.argv[2], "path": "docs/measure-writes/" + sys.argv[2] + ".md",
           "title": "measure-writes document", "body": "Created by measure-writes."}, open(sys.argv[1], "w"))
' "$root/inputs/document-create.json" "$item_id"
    api_must 'document create' document create --repo "$root/replica" \
        --input "$root/inputs/document-create.json" --request-id "$(new_id)"
}

# timed_save KIND ID RUN: ticket save or document save on an existing item. The
# token for the save comes from a fresh read, which is not timed.
timed_save() {
    local kind=$1 id=$2 run=$3
    api_must "$kind show" "$kind" show --repo "$root/replica" --id "$id"
    save_patch <(printf '%s' "$answer") "$(date +%s%N)" "$root/inputs/$kind-save.json"
    timed_api "$kind save" "$run" "$kind" save --repo "$root/replica" --id "$id" \
        --input "$root/inputs/$kind-save.json" --request-id "$(new_id)"
}

# timed_comment RUN ID: a comment on an item, run in human mode because the CLI
# writes its "progress:" lines to stderr only then. Records the whole command
# ("comment add", remote mode only) and the time until publication begins
# ("comment add (local checkpoint)").
timed_comment() {
    local run=$1 id=$2
    local errors=$root/inputs/comment.stderr output=$root/inputs/comment.stdout
    python3 -I -c '
import json, sys
json.dump({"comment_id": sys.argv[2], "body": "A comment from measure-writes."}, open(sys.argv[1], "w"))
' "$root/inputs/comment-add.json" "$(new_id)"
    local request_id start end rc=0 stamper
    request_id=$(new_id)
    check_cli
    start=$(date +%s.%N)
    scratch_env "$cli" --non-interactive comment add --repo "$root/replica" --id "$id" \
        --input "$root/inputs/comment-add.json" --request-id "$request_id" \
        2> >(stamp_lines >"$errors") >"$output" || rc=$?
    stamper=$!
    end=$(date +%s.%N)
    wait "$stamper" 2>/dev/null || true

    if [[ $local_only == true ]]; then
        # There is no remote to publish to: the comment is saved and the CLI
        # answers partial (exit 4). The whole command is not a measurement.
        ((rc == 4)) || die "comment add: expected exit 4 (saved, publication pending) in --local-only mode, got $rc: $(cat "$errors")"
    else
        ((rc == 0)) || die "comment add failed with exit $rc: $(cat "$errors")"
        record 'comment add' "$run" "$(elapsed "$start" "$end")"
    fi

    # The first stage of the publication: the local checkpoint is done. With
    # --local-only only the first comment of a root reaches it: its unfinished
    # synchronization holds the repository's synchronization reservation, so
    # later comments are saved and then answered busy without trying to publish.
    local marker
    marker=$(awk '$2 == "progress:" && ($3 == "connecting" || $3 == "fetching") { print $1; exit }' "$errors")
    if [[ -n $marker ]]; then
        record 'comment add (local checkpoint)' "$run" "$(elapsed "$start" "$marker")"
    else
        record 'comment add (local checkpoint)' "$run" NA
        note "comment add printed no publication progress line (connecting or fetching); wrote NA"
    fi
}

phase_run() {
    local runs=3 out=
    while (($#)); do
        case $1 in
            --root) root=${2:?--root needs a value}; shift 2 ;;
            --runs) runs=${2:?--runs needs a value}; shift 2 ;;
            --out) out=${2:?--out needs a value}; shift 2 ;;
            *) usage ;;
        esac
    done
    [[ $runs =~ ^[1-9][0-9]*$ ]] || die '--runs must be a positive number'
    [[ -n $out ]] || die '--out is required'
    check_root
    require_setup
    check_cli
    command -v python3 >/dev/null || die 'python3 is required'
    local_only=$(setting_get local_only)
    ssh_port=$(setting_get ssh_port)
    build_ref_label=$(setting_get build_ref)
    if [[ $local_only == false && $(setting_get trusted) != yes ]]; then
        die 'the host is not trusted yet: run trust-host first (or set up with --local-only)'
    fi
    local replica=$root/replica
    out=$(realpath -m -- "$out")
    csv_partial=$out.partial
    printf 'command,run,seconds,build_ref\n' >"$csv_partial"

    pick_fixed_items "$replica"
    local ticket document
    ticket=$(setting_get fixed_ticket)
    document=$(setting_get fixed_document)
    note "build ref: $build_ref_label ($(setting_get build_sha)); local-only: $local_only"
    note "fixed ticket: $ticket"
    note "fixed document: $document"

    # A save on a document that has no branch yet first creates the branch and
    # its worktree. That one-time cost is not what a save costs, so it is paid
    # here, untimed.
    api_must 'document show' document show --repo "$replica" --id "$document"
    if [[ $(json_get data.context.kind <<<"$answer") != active ]]; then
        note 'warm-up: the first save of the fixed document creates its branch (not timed)'
        save_patch <(printf '%s' "$answer") "$(date +%s%N)" "$root/inputs/document-save.json"
        api_must 'document save (warm-up)' document save --repo "$replica" --id "$document" \
            --input "$root/inputs/document-save.json" --request-id "$(new_id)"
    fi

    local run created
    for ((run = 1; run <= runs; run++)); do
        note "--- run $run of $runs"
        timed_save ticket "$ticket" "$run"
        timed_save document "$document" "$run"
        timed_create_ticket "$run"
        created=$item_id

        if [[ $local_only == false ]]; then
            timed_api 'item sync' "$run" item sync --repo "$replica" --id "$ticket" --request-id "$(new_id)"
            timed_comment "$run" "$ticket"

            create_document
            timed_confirmed 'document promote' "$run" document promote --repo "$replica" --id "$item_id"

            create_ticket
            timed_confirmed 'ticket close' "$run" ticket close --repo "$replica" --id "$item_id"
        else
            # A comment whose publication cannot happen leaves an unfinished
            # synchronization on its item, and that refuses the item's next
            # write. So each run comments on the ticket it just created.
            timed_comment "$run" "$created"
        fi

        timed_api 'index refresh' "$run" index refresh --repo "$replica" --request-id "$(new_id)"
        if [[ $local_only == false ]]; then
            timed_api 'poll once' "$run" poll once --repo "$replica" --request-id "$(new_id)"
        fi
    done

    local unfinished
    unfinished=$(cli operation list --repo "$replica" | grep -c . || true)
    if ((unfinished > 0)); then
        note "unfinished operations in the scratch registry: $unfinished (expected with --local-only: a comment's publication cannot reach a remote)"
    fi
    mv "$csv_partial" "$out"
    note "wrote $out"
}

case ${1:-} in
    setup) shift; phase_setup "$@" ;;
    trust-host) shift; phase_trust_host "$@" ;;
    run) shift; phase_run "$@" ;;
    *) usage ;;
esac
