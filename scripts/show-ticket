#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

script_path=${BASH_SOURCE[0]}
case $script_path in
    */*) script_directory=${script_path%/*} ;;
    *) script_directory=. ;;
esac
source "$script_directory/ticket-front-matter"

fail() {
    printf 'show-ticket: %s\n' "$*" >&2
    exit 1
}

malformed_ticket() {
    printf 'show-ticket: malformed ticket file %s: %s\n' "$1" "$2" >&2
}

malformed_comment() {
    printf 'show-ticket: malformed comment file %s: %s\n' "$1" "$2" >&2
}

is_rfc3339_utc() {
    local value=$1 year month day maximum_day

    if [[ ! $value =~ ^([0-9]{4})-(0[1-9]|1[0-2])-([0-9]{2})T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\.[0-9]+)?Z$ ]]; then
        return 1
    fi

    year=$((10#${BASH_REMATCH[1]}))
    month=$((10#${BASH_REMATCH[2]}))
    day=$((10#${BASH_REMATCH[3]}))
    case $month in
        1|3|5|7|8|10|12) maximum_day=31 ;;
        4|6|9|11) maximum_day=30 ;;
        2)
            if (( year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) )); then
                maximum_day=29
            else
                maximum_day=28
            fi
            ;;
    esac
    (( day >= 1 && day <= maximum_day ))
}

read_ticket() {
    local ticket_file=$1

    if ! read_managed_front_matter "$ticket_file" ticket; then
        malformed_ticket "$ticket_file" "$front_matter_error"
        return 1
    fi
    ticket_id=$front_matter_id
    ticket_title=$front_matter_title
    ticket_type=$front_matter_type
    ticket_status=$front_matter_status
    ticket_body_line=$front_matter_body_line
}

read_comment() {
    local comment_file=$1

    if ! read_managed_front_matter "$comment_file" comment; then
        malformed_comment "$comment_file" "$front_matter_error"
        return 1
    fi
    comment_id=$front_matter_id
    comment_item_id=$front_matter_item_id
    comment_created_at=$front_matter_created_at
    comment_body_line=$front_matter_body_line
}

print_body() {
    local file=$1 body_line=$2 body_content last_byte

    tail -n +"$body_line" -- "$file"
    body_content=$(tail -n +"$body_line" -- "$file")
    if [[ -n $body_content ]]; then
        last_byte=$(tail -c 1 -- "$file")
        if [[ -n $last_byte ]]; then
            printf '\n'
        fi
    fi
}

if (( $# != 1 )) || ! is_canonical_ulid "${1:-}"; then
    fail 'expected exactly one canonical uppercase ticket ULID argument'
fi
requested_ticket_id=$1

if ! discover_ticket_contexts; then
    fail "$context_discovery_error"
fi

ticket_candidate_files=()
ticket_candidate_contexts=()
for context in "${ticket_contexts[@]}"; do
    ticket_file=$context/.manyhands/tickets/$requested_ticket_id/ticket.md
    [[ -f $ticket_file ]] || continue

    ticket_candidate_files+=("$ticket_file")
    ticket_candidate_contexts+=("$context")
done

case ${#ticket_candidate_files[@]} in
    0) fail "ticket $requested_ticket_id not found" ;;
    1) ;;
    *) fail "multiple canonical tickets found for $requested_ticket_id" ;;
esac

selected_ticket_file=${ticket_candidate_files[0]}
selected_context=${ticket_candidate_contexts[0]}
if ! read_ticket "$selected_ticket_file"; then
    fail "ticket $requested_ticket_id is malformed"
fi
if [[ $ticket_id != "$requested_ticket_id" ]]; then
    malformed_ticket "$selected_ticket_file" 'ticket ID does not match its directory'
    fail "ticket $requested_ticket_id is malformed"
fi

render_display_value "$ticket_id"
displayed_ticket_id=$display_value
render_display_value "$ticket_status"
displayed_ticket_status=$display_value
render_display_value "$ticket_type"
displayed_ticket_type=$display_value
render_display_value "$ticket_title"
displayed_ticket_title=$display_value
printf 'ID: %s\nStatus: %s\nType: %s\nTitle: %s\n\n' \
    "$displayed_ticket_id" "$displayed_ticket_status" "$displayed_ticket_type" \
    "$displayed_ticket_title"
print_body "$selected_ticket_file" "$ticket_body_line"

comments_directory=$selected_context/.manyhands/comments/$requested_ticket_id
if [[ ! -d $comments_directory ]]; then
    printf 'Comments: none\n'
    exit 0
fi

comment_files=()
comment_timestamps=()
comment_ids=()
comment_fractional_seconds=()
timestamp_fraction_precision=1
for comment_file in "$comments_directory"/*.md; do
    [[ -f $comment_file ]] || continue
    if ! read_comment "$comment_file"; then
        continue
    fi

    comment_filename=${comment_file##*/}
    comment_filename=${comment_filename%.md}
    if ! is_canonical_ulid "$comment_id"; then
        malformed_comment "$comment_file" 'comment ID is not a canonical ULID'
    elif [[ $comment_filename != "$comment_id" ]]; then
        malformed_comment "$comment_file" 'filename does not match comment ID'
    elif [[ $comment_item_id != "$requested_ticket_id" ]]; then
        malformed_comment "$comment_file" 'item ID does not match ticket ID'
    elif ! is_rfc3339_utc "$comment_created_at"; then
        malformed_comment "$comment_file" 'created_at is not a valid RFC3339 UTC timestamp'
    else
        comment_files+=("$comment_file")
        comment_timestamps+=("$comment_created_at")
        comment_ids+=("$comment_id")
        comment_timestamp_without_zone=${comment_created_at%Z}
        if [[ $comment_timestamp_without_zone == *.* ]]; then
            fractional_seconds=${comment_timestamp_without_zone#*.}
        else
            fractional_seconds=
        fi
        comment_fractional_seconds+=("$fractional_seconds")
        if (( ${#fractional_seconds} > timestamp_fraction_precision )); then
            timestamp_fraction_precision=${#fractional_seconds}
        fi
    fi
done

if (( ${#comment_files[@]} == 0 )); then
    printf 'Comments: none\n'
    exit 0
fi

comment_sort_keys=()
for (( index = 0; index < ${#comment_files[@]}; index += 1 )); do
    comment_timestamp_without_zone=${comment_timestamps[$index]%Z}
    comment_timestamp_prefix=${comment_timestamp_without_zone%%.*}
    fractional_seconds=${comment_fractional_seconds[$index]}
    while (( ${#fractional_seconds} < timestamp_fraction_precision )); do
        fractional_seconds+=0
    done
    comment_sort_keys+=("$comment_timestamp_prefix.$fractional_seconds")
done

printf 'Comments:\n'
comment_printed=()
for (( printed_count = 0; printed_count < ${#comment_files[@]}; printed_count += 1 )); do
    selected_index=
    for (( index = 0; index < ${#comment_files[@]}; index += 1 )); do
        [[ ${comment_printed[$index]:-false} == true ]] && continue
        if [[ -z $selected_index \
            || ${comment_sort_keys[$index]} < ${comment_sort_keys[$selected_index]} \
            || ( ${comment_sort_keys[$index]} == ${comment_sort_keys[$selected_index]} \
                && ${comment_ids[$index]} < ${comment_ids[$selected_index]} ) ]]; then
            selected_index=$index
        fi
    done

    (( printed_count == 0 )) || printf '\n'
    comment_printed[$selected_index]=true
    read_comment "${comment_files[$selected_index]}"
    printf '%s %s\n' "$comment_created_at" "$comment_id"
    print_body "${comment_files[$selected_index]}" "$comment_body_line"
done
